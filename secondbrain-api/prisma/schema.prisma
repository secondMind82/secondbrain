generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ==========================================
// USER
// ==========================================

model User {
  id         String  @id @default(cuid())
  fullName   String
  email      String  @unique
  password   String?
  provider   String  @default("EMAIL")
  providerId String?
  username   String? @unique
  phone      String?
  bio        String?
  avatar     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes        Note[]
  entities     Entity[]
  timelines    Timeline[]
  diaryEntries DiaryEntry[]
  purchases    Purchase[]

  @@unique([provider, providerId])
}


// ==========================================
// NOTE
// ==========================================

model Note {
  id      String  @id @default(cuid())
  title   String
  content String
  pinned  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ==========================================
// ENTITY
// ==========================================

model Entity {
  id          String     @id @default(cuid())
  name        String
  type        EntityType
  description String?
  avatar      String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  timelineEntities TimelineEntity[]
  purchases        Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==========================================
// TIMELINE
// ==========================================

model Timeline {
  id String @id @default(cuid())

  title          String
  description    String
  eventDate      DateTime
  showOnCalendar Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  entities TimelineEntity[]
}


// ==========================================
// TIMELINE ENTITY
// ==========================================

model TimelineEntity {
  timelineId String
  entityId   String

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([timelineId, entityId])
}


// ==========================================
// DIARY ENTRY
// ==========================================

model DiaryEntry {
  id String @id @default(cuid())

  title     String
  content   String
  mood      DiaryMood
  entryDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// ==========================================
// PURCHASE
// ==========================================

model Purchase {
  id           String   @id @default(cuid())
  title        String
  totalAmount  Decimal
  purchaseDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  items PurchaseItem[]
}


// ==========================================
// PURCHASE ITEM
// ==========================================

model PurchaseItem {
  id String @id @default(cuid())

  name     String
  price    Decimal
  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}


// ==========================================
// ENUMS
// ==========================================

enum EntityType {
  PERSON
  COMPANY
}

enum DiaryMood {
  HAPPY
  SAD
  EXCITED
  CALM
  ANGRY
  ANXIOUS
  GRATEFUL
  NEUTRAL
}